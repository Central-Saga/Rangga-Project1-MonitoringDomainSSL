# Environment: development
# File ini digunakan untuk development lokal

APP_NAME="Monitoring Infra"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=monitoring_db
DB_USERNAME=monitoring
DB_PASSWORD=secret

# Cache & Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
BROADCAST_CONNECTION=log
CACHE_STORE=redis

# Queue
QUEUE_CONNECTION=redis

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525

# Vite
VITE_APP_NAME="${APP_NAME}"