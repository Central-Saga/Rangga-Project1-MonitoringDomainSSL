# Environment: production
# File ini digunakan untuk production deployment

APP_NAME="Monitoring Infra"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database
DB_CONNECTION=pgsql
DB_HOST=prod-db-host.example.com
DB_PORT=5432
DB_DATABASE=monitoring_db
DB_USERNAME=monitoring
DB_PASSWORD=${PRODUCTION_DB_PASSWORD}

# Cache & Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
BROADCAST_CONNECTION=log
CACHE_STORE=redis

# Queue
QUEUE_CONNECTION=redis

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=${PROMAIL_USERNAME}
MAIL_PASSWORD=${PROMAIL_PASSWORD}
MAIL_FROM_ADDRESS="no-reply@your-domain.com"

# AWS ( jika digunakan)
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=${AWS_BUCKET}
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"