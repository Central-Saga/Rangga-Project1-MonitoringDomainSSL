includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: false
    # Atribut Eloquent/Resource adalah magic: PHPDoc dari model sering membuat
    # perbandingan enum dianggap selalu false. Karena runtime Laravel benar,
    # jangan anggap PHPDoc sebagai kepastian mutlak.
    treatPhpDocTypesAsCertain: false
