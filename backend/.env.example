APP_NAME="Monitoring Infra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Password untuk akun uji DemoUserSeeder (admin/staff/client@example.com).
# Hanya untuk lokal/CI — jangan pakai nilai ini di produksi. (audit #92)
SEED_PASSWORD=password

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=monitoring_db
DB_USERNAME=monitoring
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Token Sanctum kedaluwarsa setelah 7 hari (menit)
SANCTUM_TOKEN_EXPIRATION=10080
# Proxy tepercaya untuk X-Forwarded-* (comma separated IP/CIDR, atau '*')
TRUSTED_PROXIES=*
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=monitoring_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Semua key yang dibaca config/*.php (audit 0.5). Nilai di bawah adalah default
# aman untuk lokal/CI; tidak ada kredensial produksi. Service yang tidak dipakai
# (S3, DynamoDB, Beanstalkd, SQS, papertrail, dll.) sengaja dikosongkan.
# ---------------------------------------------------------------------------

# app
APP_PREVIOUS_KEYS=

# auth
AUTH_GUARD=web
AUTH_MODEL="App\Models\User"
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=60

# filesystem / s3
AWS_URL=
AWS_ENDPOINT=

# queue drivers
BEANSTALKD_QUEUE_HOST=127.0.0.1
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_RETRY_AFTER=90
DB_QUEUE_CONNECTION=null
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
SQS_PREFIX=
SQS_QUEUE=
SQS_SUFFIX=
QUEUE_FAILED_DRIVER=database-uuids

# cache stores
CACHE_STORAGE_DISK=local
CACHE_STORAGE_PATH=/tmp/cache
DB_CACHE_CONNECTION=null
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=null
DB_CACHE_LOCK_TABLE=cache_locks
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=

# database extras
DB_URL=
DB_FOREIGN_KEYS=true
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_SSLMODE=prefer
MYSQL_ATTR_SSL_CA=

# logging
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_TRACE=false
LOG_PAPERTRAIL_HANDLER=false
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="Monitoring Bot"
LOG_SLACK_EMOJI=:robot_face:
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=local0
PAPERTRAIL_URL=
PAPERTRAIL_PORT=

# mail / notifications
MAIL_URL=
MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs
MAIL_LOG_CHANNEL=log
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=
RESEND_API_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# memcached extras
MEMCACHED_PERSISTENT_ID=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PORT=11211

# redis extras
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_PERSISTENT=false
REDIS_URL=
REDIS_USERNAME=null
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelatedJitterBackoffV2
REDIS_BACKOFF_BASE=500
REDIS_BACKOFF_CAP=1000
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

# sanctum / session
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_PREFIX=
SESSION_EXPIRE_ON_CLOSE=false
SESSION_CONNECTION=null
SESSION_TABLE=sessions
SESSION_STORE=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
